{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nwe.static-collision-occupancy-snapshot/0.1-candidate",
  "title": "NWE static collision occupancy snapshot candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "phase", "tick", "worldFrameId", "physicsFrame", "contacts"],
  "properties": {
    "schema": { "const": "nwe.static-collision-occupancy-snapshot/0.1-candidate" },
    "phase": { "const": "after-physics-step" },
    "tick": { "type": "integer", "minimum": 0 },
    "worldFrameId": { "type": "string", "minLength": 1 },
    "physicsFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["physicsFrameId", "epoch"],
      "properties": {
        "physicsFrameId": { "type": "string", "minLength": 1 },
        "epoch": { "type": "integer", "minimum": 0 }
      }
    },
    "contacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entityId", "collisionId", "tileId", "artifactSha256"],
        "properties": {
          "entityId": { "type": "string", "minLength": 1 },
          "collisionId": { "type": "string", "minLength": 1 },
          "tileId": { "type": "string", "minLength": 1 },
          "artifactSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
