{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nwe:schema:authoritative-world-snapshot:0.1",
  "title": "NWE Authoritative World Snapshot v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "worldFrame", "tick", "entities"],
  "properties": {
    "schema": { "const": "nwe.authoritative-world-snapshot/0.1" },
    "worldFrame": { "$ref": "#/$defs/worldFrame" },
    "tick": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "entities": {
      "type": "array",
      "items": { "$ref": "#/$defs/entity" }
    }
  },
  "$defs": {
    "worldFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "coordinateModel",
        "horizontalCrs",
        "horizontalUnit",
        "verticalDatum",
        "verticalUnit",
        "axisOrder"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "coordinateModel": { "const": "projected-cartesian-height" },
        "horizontalCrs": { "type": "string", "minLength": 1 },
        "horizontalUnit": { "const": "metre" },
        "verticalDatum": { "type": "string", "minLength": 1 },
        "verticalUnit": { "const": "metre" },
        "axisOrder": {
          "type": "array",
          "prefixItems": [
            { "const": "easting" },
            { "const": "northing" },
            { "const": "height" }
          ],
          "minItems": 3,
          "maxItems": 3
        }
      }
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["easting", "northing", "height"],
      "properties": {
        "easting": { "type": "number" },
        "northing": { "type": "number" },
        "height": { "type": "number" }
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "position"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "position": { "$ref": "#/$defs/position" }
      }
    }
  }
}
