{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://norge-world-engine.invalid/schemas/physics-frame-topology-transition-v0.1.schema.json",
  "title": "NWE Physics Frame Topology Transition v0.1 candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "tick", "worldFrameId", "transitionId", "phase", "transitionKind", "assignments", "activeConstraints", "reason"],
  "properties": {
    "schema": { "const": "nwe.physics-frame-topology-transition/0.1-candidate" },
    "tick": { "type": "integer", "minimum": 0 },
    "worldFrameId": { "type": "string", "minLength": 1 },
    "transitionId": { "type": "string", "minLength": 1 },
    "phase": { "const": "after-frame-maintenance" },
    "transitionKind": { "enum": ["split", "merge", "repartition"] },
    "assignments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entityId", "fromPhysicsFrameId", "fromEpoch", "toPhysicsFrameId", "toEpoch"],
        "properties": {
          "entityId": { "type": "string", "minLength": 1 },
          "fromPhysicsFrameId": { "type": "string", "minLength": 1 },
          "fromEpoch": { "type": "integer", "minimum": 0 },
          "toPhysicsFrameId": { "type": "string", "minLength": 1 },
          "toEpoch": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "activeConstraints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["constraintId", "entityAId", "entityBId"],
        "properties": {
          "constraintId": { "type": "string", "minLength": 1 },
          "entityAId": { "type": "string", "minLength": 1 },
          "entityBId": { "type": "string", "minLength": 1 }
        }
      }
    },
    "reason": { "type": "string", "minLength": 1 }
  }
}
